{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "{secretKey}",
    "Issuer": "PulseAuthAPI",
    "Audience": "PulseSystem",
    "ExpireMinutes": 60
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SystemPulse": "Data Source={urlConnection};User Id={username};Password={password};Connection Timeout=120;"


  }
  
}
